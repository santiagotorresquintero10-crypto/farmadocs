rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{docId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    match /documents/{docId} {
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // subcampos — global: any auth user can read/write
    match /subcampos/{docId} {
      allow read, write: if request.auth != null;
    }

    // nodes — global hierarchy (subitems, sub-subitems)
    // fields: section, parentId, level, name, desc, order, createdAt
    match /nodes/{docId} {
      allow read, write: if request.auth != null;
    }

    // node_docs — files/links attached to any node
    // fields: nodeId, nombre, link, imageData, imageType, imageName, createdAt
    match /node_docs/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
